// version.rc.in —— Windows VERSIONINFO 资源模板（CommonCMake 通用）
// 由 add_windows_version_resource() 做 configure_file(@ONLY) 注入占位符后，
// 随目标编译，使文件属性"详细信息"中显示文件版本/产品版本。
//
// 占位符（由 add_windows_version_resource() 在调用作用域内提供）：
//   @PROJECT_VERSION@        点分版本号，如 1.0.0.0
//   @PROJECT_VERSION_COMMA@  逗号版版本号，如 1,0,0,0
//   @PROJECT_COMPANY_NAME@ / @PROJECT_FILE_DESCRIPTION@ / @PROJECT_INTERNAL_NAME@
//   @PROJECT_LEGAL_COPYRIGHT@ / @PROJECT_ORIGINAL_FILENAME@ / @PROJECT_PRODUCT_NAME@
#include <winver.h>

#define VER_FILEVERSION            @PROJECT_VERSION_COMMA@
#define VER_FILEVERSION_STR        "@PROJECT_VERSION@\0"
#define VER_PRODUCTVERSION         @PROJECT_VERSION_COMMA@
#define VER_PRODUCTVERSION_STR     "@PROJECT_VERSION@\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_COMMA@
 PRODUCTVERSION @PROJECT_VERSION_COMMA@
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@PROJECT_COMPANY_NAME@"
            VALUE "FileDescription",  "@PROJECT_FILE_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@PROJECT_INTERNAL_NAME@"
            VALUE "LegalCopyright",   "@PROJECT_LEGAL_COPYRIGHT@"
            VALUE "OriginalFilename", "@PROJECT_ORIGINAL_FILENAME@"
            VALUE "ProductName",      "@PROJECT_PRODUCT_NAME@"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
